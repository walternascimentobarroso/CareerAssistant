{
  "name": "career-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node --import tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "test:postgres": "node --import tsx --test server/postgres.test.ts",
    "db:export": "node --import tsx scripts/export.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
